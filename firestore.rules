rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Health check endpoint
    match /test/{testId} {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Client-side users cannot write or tamper with subscription fields.
      // Privileged subscription updates are executed exclusively by the trusted backend Firebase Admin SDK.
      allow create: if isOwner(userId) && 
        (!('subscription' in request.resource.data)) &&
        (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan in ['free', 'starter']);
        
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'subscriptionPlan']));
      
      allow delete: if isOwner(userId);

      // User strategies subcollection
      match /strategies/{strategyId} {
        allow read, write: if isOwner(userId);
      }

      // User ideas subcollection
      match /ideas/{ideaId} {
        allow read, write: if isOwner(userId);
      }

      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // User chats subcollection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
      }

      // User usage subcollection
      match /usage/{usageId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Shared strategies
    match /shared_strategies/{strategyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Backend Webhook Events collection (accessed only via Firebase Admin SDK)
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
